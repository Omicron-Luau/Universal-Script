-- ===================== DADOS =====================

local PlayerRoles = {}
local CurrentMethod = "Inventário"

local function setMethod(method)
	CurrentMethod = method
end

local function updateRoles(data)

	for username, info in pairs(data) do

		PlayerRoles[username] = {
			Role = info.Role,
			Dead = info.Dead
		}
	end
end

FadeRemote.OnClientEvent:Connect(function(data)

	PlayerRoles = {}
	updateRoles(data)
end)

PlayerDataChanged.OnClientEvent:Connect(function(data)

	updateRoles(data)
end)

