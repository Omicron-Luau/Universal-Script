-- ===================== CONTROLE =====================

local ESP_KnifeOn = false
local ESP_GunOn = false
local ESP_InnocentOn = false

local ESPColors = {
	Murderer = Color3.fromRGB(255,0,0),
	Sheriff = Color3.fromRGB(0,0,255),
	Innocent = Color3.fromRGB(0,255,0)
}

local ESPBoxes = {}

function removeESP(player)

	if ESPBoxes[player] then

		for _, box in pairs(ESPBoxes[player]) do
			box:Destroy()
		end

		ESPBoxes[player] = nil
	end
end

local function createBox(part, color)

	local box = Instance.new("BoxHandleAdornment")

	box.Adornee = part
	box.AlwaysOnTop = true
	box.ZIndex = 10
	box.Size = part.Size + Vector3.new(0.05,0.05,0.05)
	box.Color3 = color
	box.Transparency = 0.5
	box.Parent = game.CoreGui

	return box
end

local function createESP(player, color)

	local character = player.Character
	if not character then return end

	if ESPBoxes[player] then return end

	ESPBoxes[player] = {}

	for _, part in ipairs(character:GetChildren()) do

		if part:IsA("BasePart") then

			local box = createBox(part, color)
			table.insert(ESPBoxes[player], box)
		end
	end
end

-- ===================== ROLES =====================

local function getInventoryRole(player)

	local character = player.Character
	if not character then return nil end

	local backpack = player:FindFirstChild("Backpack")

	if backpack then

		for _, item in ipairs(backpack:GetChildren()) do

			local name = item.Name:lower()

			if name == "knife" then
				setMethod("Remote + Inventário")
				return "Murderer"

			elseif name == "gun" then
				setMethod("Inventário")
				return "Sheriff"
			end
		end
	end

	for _, item in ipairs(character:GetDescendants()) do

		local name = item.Name:lower()

		if name == "knife" then
			setMethod("Remote + Inventário")
			return "Murderer"

		elseif name == "gun" then
			setMethod("Inventário")
			return "Sheriff"
		end
	end

	return nil
end

local function getRemoteRole(player)

	local data = PlayerRoles[player.Name]

	if not data then
		return nil
	end

	if data.Dead then
		return nil
	end

	setMethod("Remote")

	return data.Role
end

local function getPlayerRole(player)

	local inventoryRole = getInventoryRole(player)

	if inventoryRole then
		return inventoryRole
	end

	local remoteRole = getRemoteRole(player)

	if remoteRole then
		return remoteRole
	end

	return "Innocent"
end

-- ===================== AVATARES =====================

local function updateRoleImages()

	local murdererFound = false
	local sheriffFound = false

	-- Agora inclui o próprio jogador local na verificação
	for _, player in ipairs(Players:GetPlayers()) do

		local role = getPlayerRole(player)

		if role == "Murderer" and not murdererFound then

			MurdererImage.Image =
				"https://www.roblox.com/avatar-thumbnail/image?userId="
				.. player.UserId ..
				"&width=720&height=720&format=png"

			MurdererName.Text =
				player.DisplayName ..
				" (" .. player.Name .. ")"

			murdererFound = true
		end

		if (role == "Sheriff" or role == "Hero")
			and not sheriffFound then

			SheriffImage.Image =
				"https://www.roblox.com/avatar-thumbnail/image?userId="
				.. player.UserId ..
				"&width=720&height=720&format=png"

			SheriffName.Text =
				player.DisplayName ..
				" (" .. player.Name .. ")"

			sheriffFound = true
		end
	end

	if not murdererFound then
		MurdererImage.Image = ""
		MurdererName.Text = ""
	end

	if not sheriffFound then
		SheriffImage.Image = ""
		SheriffName.Text = ""
	end
end

-- ===================== UPDATE =====================

local function updateESP()

	StatusLabel.Text = "Método: " .. CurrentMethod

	for _, player in ipairs(Players:GetPlayers()) do

		-- O jogador local nunca recebe ESP
		if player ~= LocalPlayer then

			local isAlive = player:GetAttribute("Alive")

			if not isAlive or isPlayerInZone(player) then

				removeESP(player)

			else

				local role = getPlayerRole(player)
				local color = nil

				if role == "Murderer" and ESP_KnifeOn then

					color = ESPColors.Murderer

				elseif (role == "Sheriff" or role == "Hero")
					and ESP_GunOn then

					color = ESPColors.Sheriff

				elseif role == "Innocent"
					and ESP_InnocentOn then

					color = ESPColors.Innocent
				end

				if color then

					if ESPBoxes[player] then

						local first = ESPBoxes[player][1]

						if first and first.Color3 ~= color then
							removeESP(player)
						end
					end

					createESP(player, color)

				else
					removeESP(player)
				end
			end
		end
	end
end

